# Postgres connection — matches docker-compose defaults
DATABASE_URL=postgres://lore:lore@localhost:5432/lore

# Express port (Vite dev server proxies /api and /mcp to this)
PORT=3000

# MCP API key — set to any non-empty string in production to require Bearer auth
# Leave as "dev-key" locally to skip auth
MCP_API_KEY=dev-key

# Outbound webhook (S5): POST a JSON {text,event} on each human verdict (approved/rejected/clarify).
# Leave empty to disable. Slack/Discord/Teams incoming-webhook URLs work directly (they render `text`).
LORE_WEBHOOK_URL=
LORE_WEBHOOK_TIMEOUT_MS=5000

# Jira integration (S5·C): on approval, create/comment a documentation ticket.
# Leave JIRA_BASE_URL empty to disable. API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_TIMEOUT_MS=10000
# Public base URL of the Lore UI, used for the "Lore: …/rule/<id>" back-link in tickets (optional).
LORE_CATALOG_BASE_URL=

# Auth (S6): JWT signing (HS256). REQUIRED in production — the server hard-fails if NODE_ENV=production
# and this is unset. Dev/test fall back to an insecure default with a warning.
JWT_SECRET=
JWT_EXPIRES_IN=12h
