{
  "name": "@knowledge-loop/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "backfill": "tsx src/scripts/backfill-embeddings.ts",
    "backfill:search-text": "tsx src/scripts/backfill-search-text.ts",
    "user:create": "tsx src/scripts/create-user.ts",
    "flow:policy": "tsx src/scripts/set-flow-policy.ts",
    "workspace:create": "tsx src/scripts/create-workspace.ts",
    "workspace:add-user": "tsx src/scripts/add-workspace-member.ts",
    "test": "EMBEDDING_PROVIDER=none vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.41.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.5",
    "uuid": "^11.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
